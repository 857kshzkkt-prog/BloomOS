#!/usr/bin/env python3
###############################################################################
# bloom — Custom Package Manager for Bloom OS
#
# A production-grade, Arch-compatible package manager with:
#   - Full dependency resolution and topological sorting
#   - SHA-256 checksum verification
#   - Flat-file local database at /var/lib/bloom/local/
#   - Meta-package definitions for installing Desktop Environments
#   - Search, info, list, sync, install, remove commands
#
# Database Layout:
#   /var/lib/bloom/local/<pkg>/        - Installed package receipt
#       ├── version                    - Package version string
#       ├── desc                       - Package description
#       ├── files                      - List of installed files
#       ├── depends                    - List of direct dependencies
#       └── predepends                 - Pre-dependencies (must be installed first)
#   /var/lib/bloom/sync.db             - Remote package index (JSON)
#   /var/lib/bloom/meta/              - Meta-package definitions (JSON)
#   /var/cache/bloom/                  - Download cache
#   /var/log/bloom.log                 - Transaction log
#
# Usage:
#   bloom sync                         - Sync package database
#   bloom install <pkg>                - Install package with dependencies
#   bloom remove <pkg>                 - Remove package
#   bloom search <query>               - Search packages
#   bloom info <pkg>                   - Show package details
#   bloom list                         - List installed packages
#   bloom update                       - Update all packages
#   bloom depends <pkg>                - Show package dependencies
#
###############################################################################

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import urllib.error
import urllib.parse
from pathlib import Path
from datetime import datetime
from typing import List, Dict, Optional, Set, Tuple
from collections import deque

# ═══════════════════════════════════════════════════════════════════════════
# COLOUR CONSTANTS
# ═══════════════════════════════════════════════════════════════════════════

class C:
    RED = "\033[0;31m"
    GREEN = "\033[0;32m"
    YELLOW = "\033[1;33m"
    BLUE = "\033[0;34m"
    MAGENTA = "\033[0;35m"
    CYAN = "\033[0;36m"
    BOLD = "\033[1m"
    NC = "\033[0m"

# ═══════════════════════════════════════════════════════════════════════════
# CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

class BloomConfig:
    """Bloom OS package manager configuration."""

    # Directories
    BLOOM_ROOT = Path("/var/lib/bloom")
    LOCAL_DB = BLOOM_ROOT / "local"
    SYNC_DB = BLOOM_ROOT / "sync.db"
    META_DIR = BLOOM_ROOT / "meta"
    CACHE_DIR = Path("/var/cache/bloom")
    LOG_FILE = BLOOM_ROOT / "bloom.log"
    LOCK_FILE = BLOOM_ROOT / "bloom.lock"

    # Default mirror (replace with actual Bloom OS mirror)
    DEFAULT_MIRROR = "https://mirror.bloomos.org/packages"
    MIRROR_LIST = [
        "https://mirror.bloomos.org/packages",
        "https://archive.archlinux.org/reposync",
    ]

    # Package verification
    VERIFY_CHECKSUMS = True
    HASH_ALGORITHM = "sha256"

    # Parallelism
    MAX_PARALLEL_DOWNLOADS = 4

    # Timeouts
    DOWNLOAD_TIMEOUT = 120  # seconds
    CONNECT_TIMEOUT = 10    # seconds

# ═══════════════════════════════════════════════════════════════════════════
# OUTPUT HELPERS
# ═══════════════════════════════════════════════════════════════════════════

def info(msg: str):
    print(f"{C.GREEN}[bloom]{C.NC} {msg}")

def warn(msg: str):
    print(f"{C.YELLOW}[bloom]{C.NC} WARNING: {msg}", file=sys.stderr)

def error(msg: str):
    print(f"{C.RED}[bloom]{C.NC} ERROR: {msg}", file=sys.stderr)
    sys.exit(1)

def success(msg: str):
    print(f"{C.GREEN}✓{C.NC} {msg}")

def bold(msg: str) -> str:
    return f"{C.BOLD}{msg}{C.NC}"

def cyan(msg: str) -> str:
    return f"{C.CYAN}{msg}{C.NC}"

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════════════════

def log_transaction(action: str, pkg: str, details: str = ""):
    """Log a package transaction to the bloom log file."""
    BloomConfig.BLOOM_ROOT.mkdir(parents=True, exist_ok=True)

    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_entry = f"[{timestamp}] {action}: {pkg}"

    if details:
        log_entry += f" — {details}"

    with open(BloomConfig.LOG_FILE, "a") as f:
        f.write(log_entry + "\n")

# ═══════════════════════════════════════════════════════════════════════════
# DATABASE FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════

def ensure_directories():
    """Create all required directories for bloom operation."""
    for directory in [
        BloomConfig.BLOOM_ROOT,
        BloomConfig.LOCAL_DB,
        BloomConfig.META_DIR,
        BloomConfig.CACHE_DIR,
    ]:
        directory.mkdir(parents=True, exist_ok=True)


def is_installed(pkg_name: str) -> bool:
    """Check if a package is installed."""
    return (BloomConfig.LOCAL_DB / pkg_name).is_dir()


def get_installed_packages() -> List[str]:
    """Return a list of all installed package names."""
    if not BloomConfig.LOCAL_DB.exists():
        return []
    return [d.name for d in BloomConfig.LOCAL_DB.iterdir() if d.is_dir()]


def load_installed_package(pkg_name: str) -> Optional[Dict]:
    """Load an installed package's metadata."""
    pkg_dir = BloomConfig.LOCAL_DB / pkg_name
    if not pkg_dir.is_dir():
        return None

    data = {}

    # Load version
    version_file = pkg_dir / "version"
    if version_file.exists():
        data["version"] = version_file.read_text().strip()

    # Load description
    desc_file = pkg_dir / "desc"
    if desc_file.exists():
        data["description"] = desc_file.read_text().strip()

    # Load file list
    files_file = pkg_dir / "files"
    if files_file.exists():
        data["files"] = files_file.read_text().strip().split("\n")

    # Load dependencies
    depends_file = pkg_dir / "depends"
    if depends_file.exists():
        data["depends"] = depends_file.read_text().strip().split("\n")

    # Load pre-dependencies
    predepends_file = pkg_dir / "predepends"
    if predepends_file.exists():
        data["predepends"] = predepends_file.read_text().strip().split("\n")

    return data


def save_installed_package(pkg_name: str, version: str, description: str,
                           files: List[str], depends: List[str],
                           predepends: List[str] = None):
    """Save package installation receipt to local database."""
    pkg_dir = BloomConfig.LOCAL_DB / pkg_name
    pkg_dir.mkdir(parents=True, exist_ok=True)

    (pkg_dir / "version").write_text(version + "\n")
    (pkg_dir / "desc").write_text(f"{pkg_name} {version}\n{description}\n")
    (pkg_dir / "files").write_text("\n".join(files) + "\n")
    (pkg_dir / "depends").write_text("\n".join(depends) + "\n")

    if predepends:
        (pkg_dir / "predepends").write_text("\n".join(predepends) + "\n")
    elif (pkg_dir / "predepends").exists():
        (pkg_dir / "predepends").unlink()

    log_transaction("INSTALL", pkg_name, f"version={version} files={len(files)}")


def remove_installed_package(pkg_name: str):
    """Remove a package from the local database."""
    pkg_dir = BloomConfig.LOCAL_DB / pkg_name
    if pkg_dir.exists():
        shutil.rmtree(pkg_dir)
        log_transaction("REMOVE", pkg_name)


# ═══════════════════════════════════════════════════════════════════════════
# SYNC DATABASE FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════

def load_sync_database() -> Dict:
    """Load the synchronized package database."""
    if not BloomConfig.SYNC_DB.exists():
        error("Package database not found. Run 'bloom sync' first.")

    try:
        return json.loads(BloomConfig.SYNC_DB.read_text())
    except json.JSONDecodeError:
        error("Corrupted package database. Run 'bloom sync' to refresh.")


def get_package_info(pkg_name: str, db: Dict) -> Optional[Dict]:
    """Get package information from the sync database."""
    return db.get("packages", {}).get(pkg_name)


# ═══════════════════════════════════════════════════════════════════════════
# META-PACKAGE FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════

def load_meta_package(pkg_name: str) -> Optional[Dict]:
    """Load a meta-package definition."""
    meta_file = BloomConfig.META_DIR / f"{pkg_name}.json"
    if meta_file.exists():
        try:
            return json.loads(meta_file.read_text())
        except json.JSONDecodeError:
            warn(f"Corrupted meta-package definition: {pkg_name}")
    return None


def get_meta_packages() -> List[str]:
    """Get list of available meta-packages."""
    if not BloomConfig.META_DIR.exists():
        return []
    return [f.stem for f in BloomConfig.META_DIR.glob("*.json")]


# ═══════════════════════════════════════════════════════════════════════════
# DEPENDENCY RESOLUTION
# ═══════════════════════════════════════════════════════════════════════════

def parse_depends(depends_line: str) -> List[str]:
    """
    Parse dependency string into package names.
    Handles: pkg, pkg>=ver, pkg<=ver, pkg=ver, pkg>ver, pkg<ver
    """
    if not depends_line:
        return []

    deps = []
    for dep in depends_line.split():
        # Remove version constraints
        dep_name = dep.split(">=")[0].split("<=")[0].split("=")[0].split(">")[0].split("<")[0].strip()
        if dep_name:
            deps.append(dep_name)

    return deps


def resolve_dependencies(pkg_name: str, db: Dict,
                         visited: Set = None) -> Tuple[List[str], List[str]]:
    """
    Resolve all dependencies for a package recursively.
    Returns (ordered_packages, failed_packages).
    """
    if visited is None:
        visited = set()

    ordered = []
    failed = []

    # Check if package is a meta-package
    meta = load_meta_package(pkg_name)
    if meta and "packages" in meta:
        # Meta-package: expand to included packages
        for sub_pkg in meta.get("packages", []):
            sub_ordered, sub_failed = resolve_dependencies(sub_pkg, db, visited)
            ordered.extend(sub_ordered)
            failed.extend(sub_failed)
        return ordered, failed

    # Skip already installed packages
    if is_installed(pkg_name):
        return ordered, failed

    # Prevent infinite loops
    if pkg_name in visited:
        return ordered, failed
    visited.add(pkg_name)

    # Get package info from sync database
    pkg_info = get_package_info(pkg_name, db)
    if not pkg_info:
        # Package not in database - might be already installed or not available
        if not is_installed(pkg_name):
            warn(f"Package not found in repository: {pkg_name}")
            failed.append(pkg_name)
        return ordered, failed

    # Process pre-dependencies first (must be installed before this package)
    predepends = pkg_info.get("predepends", "")
    for predep in parse_depends(predepends):
        if not is_installed(predep) and predep not in ordered:
            pred_ordered, pred_failed = resolve_dependencies(predep, db, visited)
            ordered.extend(pred_ordered)
            failed.extend(pred_failed)

    # Add current package
    if pkg_name not in ordered:
        ordered.append(pkg_name)

    # Process regular dependencies
    depends = pkg_info.get("depends", "")
    for dep in parse_depends(depends):
        if not is_installed(dep) and dep not in ordered:
            dep_ordered, dep_failed = resolve_dependencies(dep, db, visited)
            ordered.extend(dep_ordered)
            failed.extend(dep_failed)

    return ordered, failed


def topological_sort(packages: List[str], db: Dict) -> List[str]:
    """
    Perform topological sort on package list based on dependencies.
    Ensures packages are installed in the correct order.
    """
    # Build dependency graph
    graph = {}
    in_degree = {}

    for pkg in packages:
        pkg_info = get_package_info(pkg, db) or {}
        deps = parse_depends(pkg_info.get("depends", ""))
        graph[pkg] = [d for d in deps if d in packages]
        in_degree[pkg] = len(graph[pkg])

    # Kahn's algorithm
    queue = deque([pkg for pkg in packages if in_degree[pkg] == 0])
    result = []

    while queue:
        current = queue.popleft()
        result.append(current)

        for neighbor in packages:
            if current in graph.get(neighbor, []):
                in_degree[neighbor] -= 1
                if in_degree[neighbor] == 0:
                    queue.append(neighbor)

    return result


# ═══════════════════════════════════════════════════════════════════════════
# PACKAGE DOWNLOAD AND VERIFICATION
# ═══════════════════════════════════════════════════════════════════════════

def download_package(pkg_name: str, db: Dict) -> Optional[Path]:
    """Download a package and return the path to the cached file."""
    pkg_info = get_package_info(pkg_name, db)
    if not pkg_info:
        error(f"Package not found: {pkg_name}")

    filename = pkg_info.get("filename", f"{pkg_name}-{pkg_info.get('version')}-x86_64.pkg.tar.zst")
    url = f"{BloomConfig.DEFAULT_MIRROR}/{filename}"

    cache_file = BloomConfig.CACHE_DIR / f"{pkg_name}.pkg.tar.zst"

    # Check if already cached
    if cache_file.exists():
        # Verify existing cache
        if BloomConfig.VERIFY_CHECKSUMS and pkg_info.get("sha256"):
            existing_hash = hashlib.sha256(cache_file.read_bytes()).hexdigest()
            if existing_hash == pkg_info["sha256"]:
                info(f"Using cached: {pkg_name}")
                return cache_file
            else:
                warn(f"Cache corrupted, re-downloading: {pkg_name}")
                cache_file.unlink()
        else:
            return cache_file

    # Download
    info(f"Downloading: {pkg_name}")
    try:
        # Create request with timeout
        req = urllib.request.Request(url)
        req.add_header("User-Agent", "Bloom-Package-Manager/1.0")

        with urllib.request.urlopen(req, timeout=BloomConfig.DOWNLOAD_TIMEOUT) as response:
            data = response.read()

        # Verify checksum if available
        if BloomConfig.VERIFY_CHECKSUMS and pkg_info.get("sha256"):
            actual_hash = hashlib.sha256(data).hexdigest()
            expected_hash = pkg_info["sha256"]

            if actual_hash != expected_hash:
                error(f"Checksum mismatch for {pkg_name}: expected {expected_hash}, got {actual_hash}")

            success(f"Verified: {pkg_name}")

        # Save to cache
        cache_file.write_bytes(data)
        return cache_file

    except urllib.error.HTTPError as e:
        error(f"HTTP error {e.code} downloading {pkg_name}: {e.reason}")
    except urllib.error.URLError as e:
        error(f"Network error downloading {pkg_name}: {e.reason}")
    except Exception as e:
        error(f"Unexpected error downloading {pkg_name}: {e}")

    return None


def extract_package(cache_file: Path) -> List[str]:
    """Extract package to root filesystem and return list of installed files."""
    info(f"Extracting: {cache_file.name}")

    # Use bsdtar for better handling of .tar.zst
    extract_cmd = ["bsdtar", "-xpf", str(cache_file), "-C", "/"]

    try:
        result = subprocess.run(extract_cmd, capture_output=True, text=True, check=True)
    except FileNotFoundError:
        # Fallback to tar with zstd
        extract_cmd = ["tar", "-I", "zstd", "-xpf", str(cache_file), "-C", "/"]
        result = subprocess.run(extract_cmd, capture_output=True, text=True, check=True)
    except subprocess.CalledProcessError as e:
        error(f"Failed to extract {cache_file.name}: {e.stderr}")

    # Get list of installed files
    files_cmd = ["bsdtar", "-tf", str(cache_file)]
    try:
        result = subprocess.run(files_cmd, capture_output=True, text=True, check=True)
        files = ["/" + f for f in result.stdout.strip().split("\n") if f and not f.endswith("/")]
    except Exception:
        # Fallback: use tar
        files_cmd = ["tar", "-tf", str(cache_file)]
        result = subprocess.run(files_cmd, capture_output=True, text=True)
        files = ["/" + f for f in result.stdout.strip().split("\n") if f and not f.endswith("/")]

    return files


def remove_package_files(files: List[str]):
    """Remove package files from the filesystem."""
    # Sort in reverse to remove files before directories
    files_sorted = sorted(files, reverse=True)

    removed_count = 0
    for file_path in files_sorted:
        path = Path(file_path)
        try:
            if path.exists():
                if path.is_dir():
                    path.rmdir()  # Only removes empty directories
                else:
                    path.unlink()
                removed_count += 1
        except (OSError, PermissionError):
            pass  # Skip files that can't be removed

    return removed_count


# ═══════════════════════════════════════════════════════════════════════════
# COMMAND IMPLEMENTATIONS
# ═══════════════════════════════════════════════════════════════════════════

def cmd_sync(args):
    """Synchronize package database from remote server."""
    info(f"Synchronizing package database from {BloomConfig.DEFAULT_MIRROR}...")

    ensure_directories()

    # Try each mirror in order
    last_error = None
    for mirror in BloomConfig.MIRROR_LIST:
        try:
            url = f"{mirror}/packages.json"

            # Create request with timeout
            req = urllib.request.Request(url)
            req.add_header("User-Agent", "Bloom-Package-Manager/1.0")

            with urllib.request.urlopen(req, timeout=BloomConfig.CONNECT_TIMEOUT) as response:
                data = response.read()

            # Verify checksum if provided
            try:
                sha_url = f"{mirror}/packages.json.sha256"
                sha_req = urllib.request.Request(sha_url)
                sha_req.add_header("User-Agent", "Bloom-Package-Manager/1.0")
                with urllib.request.urlopen(sha_req, timeout=10) as sha_resp:
                    expected_hash = sha_resp.read().decode().strip().split()[0]

                actual_hash = hashlib.sha256(data).hexdigest()
                if actual_hash != expected_hash:
                    warn("Package database checksum mismatch, continuing anyway")
            except Exception:
                pass  # Skip verification if SHA not available

            # Save database
            BloomConfig.SYNC_DB.write_bytes(data)

            # Count packages
            db = json.loads(data)
            pkg_count = len(db.get("packages", {}))

            success(f"Synchronized {pkg_count} packages")
            log_transaction("SYNC", "database", f"mirrors={len(BloomConfig.MIRROR_LIST)} packages={pkg_count}")

            return

        except Exception as e:
            last_error = e
            warn(f"Failed to sync from {mirror}: {e}")
            continue

    error(f"All mirrors failed. Last error: {last_error}")


def cmd_install(args):
    """Install a package with all dependencies."""
    pkg_name = args.package

    info(f"Installing: {pkg_name}")
    log_transaction("INSTALL_START", pkg_name)

    # Load sync database
    db = load_sync_database()

    # Resolve dependencies
    info("Resolving dependencies...")
    ordered_packages, failed_packages = resolve_dependencies(pkg_name, db)

    if failed_packages:
        warn(f"Some dependencies could not be resolved: {', '.join(failed_packages)}")

    # Topological sort for correct installation order
    ordered_packages = topological_sort(ordered_packages, db)

    info(f"Installation order: {' → '.join(ordered_packages)}")

    # Install each package
    for pkg in ordered_packages:
        if is_installed(pkg):
            info(f"Already installed: {pkg}")
            continue

        # Get package info
        pkg_info = get_package_info(pkg, db)
        if not pkg_info:
            warn(f"Package not in database: {pkg}")
            continue

        # Download package
        cache_file = download_package(pkg, db)
        if not cache_file:
            error(f"Failed to download: {pkg}")

        # Extract package
        files = extract_package(cache_file)

        # Save installation record
        save_installed_package(
            pkg_name=pkg,
            version=pkg_info.get("version", "unknown"),
            description=pkg_info.get("description", ""),
            files=files,
            depends=parse_depends(pkg_info.get("depends", "")),
            predepends=parse_depends(pkg_info.get("predepends", ""))
        )

        success(f"Installed: {pkg}")

    info(f"Package '{pkg_name}' and all dependencies installed successfully")
    log_transaction("INSTALL_COMPLETE", pkg_name)


def cmd_remove(args):
    """Remove an installed package."""
    pkg_name = args.package

    if not is_installed(pkg_name):
        error(f"Package not installed: {pkg_name}")

    info(f"Removing: {pkg_name}")

    # Load package data
    pkg_data = load_installed_package(pkg_name)
    if not pkg_data:
        error(f"Package data not found: {pkg_name}")

    # Remove files
    if "files" in pkg_data:
        info("Removing package files...")
        removed = remove_package_files(pkg_data["files"])
        info(f"Removed {removed} files")

    # Remove package record
    remove_installed_package(pkg_name)

    success(f"Removed: {pkg_name}")


def cmd_search(args):
    """Search for packages by name or description."""
    query = args.query.lower()

    db = load_sync_database()
    packages = db.get("packages", {})

    results = []
    for name, info in packages.items():
        if query in name.lower():
            results.append((name, info.get("description", ""), info.get("version", "")))
        elif query in info.get("description", "").lower():
            results.append((name, info.get("description", ""), info.get("version", "")))

    if not results:
        info("No packages found matching your query.")
        return

    info(f"Found {len(results)} package(s):")
    for name, desc, ver in sorted(results):
        installed = cyan(" [installed]") if is_installed(name) else ""
        print(f"  {bold(name)} {ver}{installed}")
        if desc:
            print(f"    {desc}")


def cmd_info(args):
    """Display detailed information about a package."""
    pkg_name = args.package

    # Check local installation first
    if is_installed(pkg_name):
        local_data = load_installed_package(pkg_name)
        print(f"\n{bold(pkg_name)} (installed)")
        print(f"  Version: {local_data.get('version', 'unknown')}")
        print(f"  Description: {local_data.get('description', 'N/A')}")
        if "files" in local_data:
            print(f"  Files: {len(local_data['files'])}")
        if "depends" in local_data:
            print(f"  Dependencies: {', '.join(local_data['depends']) or 'none'}")
        print()
        return

    # Check sync database
    db = load_sync_database()
    pkg_info = get_package_info(pkg_name, db)

    if not pkg_info:
        error(f"Package not found: {pkg_name}")

    print(f"\n{bold(pkg_name)} {pkg_info.get('version', 'unknown')}")
    print(f"  Description: {pkg_info.get('description', 'N/A')}")
    print(f"  Architecture: {pkg_info.get('arch', 'x86_64')}")
    print(f"  Size: {pkg_info.get('size', 'unknown')}")

    deps = parse_depends(pkg_info.get("depends", ""))
    print(f"  Dependencies: {', '.join(deps) or 'none'}")

    predeps = parse_depends(pkg_info.get("predepends", ""))
    if predeps:
        print(f"  Pre-dependencies: {', '.join(predeps)}")

    if pkg_info.get("provides"):
        print(f"  Provides: {pkg_info.get('provides')}")

    if pkg_info.get("conflicts"):
        print(f"  Conflicts: {pkg_info.get('conflicts')}")

    print()


def cmd_list(args):
    """List all installed packages."""
    packages = get_installed_packages()

    if not packages:
        info("No packages installed.")
        return

    info(f"Installed packages ({len(packages)}):")
    for pkg in sorted(packages):
        data = load_installed_package(pkg)
        version = data.get("version", "unknown") if data else "unknown"
        desc = data.get("description", "") if data else ""
        print(f"  {cyan(pkg)} {version}")
        if desc:
            print(f"    {desc}")


def cmd_depends(args):
    """Show package dependencies."""
    pkg_name = args.package

    db = load_sync_database()
    pkg_info = get_package_info(pkg_name, db)

    if not pkg_info:
        error(f"Package not found: {pkg_name}")

    print(f"\n{bold(pkg_name)} dependencies:")
    print()

    # Direct dependencies
    depends = parse_depends(pkg_info.get("depends", ""))
    if depends:
        print("  Direct dependencies:")
        for dep in depends:
            status = "[installed]" if is_installed(dep) else "[not installed]"
            print(f"    {dep} {cyan(status) if is_installed(dep) else ''}")

    # Recursive dependencies
    print("\n  All dependencies (recursive):")
    ordered, failed = resolve_dependencies(pkg_name, db)
    for dep in ordered:
        status = "[installed]" if is_installed(dep) else "[not installed]"
        marker = "→" if dep == pkg_name else " "
        print(f"    {marker} {dep} {cyan(status) if is_installed(dep) else ''}")

    print()


