# ═══════════════════════════════════════════════════════════════════════════
# MAIN CLI DISPATCHER
# ═══════════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        prog="bloom",
        description=bold("Bloom OS Package Manager") + "\n" +
                     "Ultra-lightweight Arch-compatible package management",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  bloom sync                        Synchronize package database
  bloom install firefox            Install a package
  bloom remove firefox             Remove a package
  bloom search firefox             Search for packages
  bloom list                       List installed packages
  bloom install gnome-core         Install full GNOME desktop environment
  bloom install kde-plasma         Install full KDE Plasma desktop
  bloom install xfce               Install XFCE desktop environment
  bloom install i3-wm             Install i3 window manager
  bloom install sway-wm            Install Sway Wayland compositor
        """
    )

    sub = parser.add_subparsers(dest="command", help="Available commands")

    # sync
    sub.add_parser("sync", help="Synchronize package database from mirror")

    # install
    p_install = sub.add_parser("install", help="Install a package")
    p_install.add_argument("package", help="Package name to install")
    p_install.add_argument("packages", nargs="*", help="Additional packages to install")

    # remove
    p_remove = sub.add_parser("remove", help="Remove an installed package")
    p_remove.add_argument("package", help="Package name to remove")

    # search
    p_search = sub.add_parser("search", help="Search for packages")
    p_search.add_argument("query", help="Search query")

    # info
    p_info = sub.add_parser("info", help="Show package information")
    p_info.add_argument("package", help="Package name")

    # list
    sub.add_parser("list", help="List installed packages")

    # depends
    p_depends = sub.add_parser("depends", help="Show package dependencies")
    p_depends.add_argument("package", help="Package name")

    # meta-init (internal)
    sub.add_parser("meta-init", help=argparse.SUPPRESS)

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        print()
        info("Run 'bloom sync' first to download the package database.")
        sys.exit(0)

    # Ensure directories exist
    ensure_directories()

    # Dispatch to command handler
    if args.command == "sync":
        cmd_sync(args)
    elif args.command == "install":
        # Handle multiple packages
        packages = [args.package] + args.packages
        for pkg in packages:
            args.package = pkg
            cmd_install(args)
    elif args.command == "remove":
        cmd_remove(args)
    elif args.command == "search":
        cmd_search(args)
    elif args.command == "info":
        cmd_info(args)
    elif args.command == "list":
        cmd_list(args)
    elif args.command == "depends":
        cmd_depends(args)
    elif args.command == "meta-init":
        cmd_meta_init(args)
    else:
        parser.print_help()


if __name__ == "__main__":
    main()