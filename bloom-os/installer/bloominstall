# ═══════════════════════════════════════════════════════════════════════════
# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════════════════

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
  --auto              Run in automatic mode with default options
  --debug             Enable debug mode with verbose trace output
  --help, -h          Show this help message

Examples:
  $0                  # Interactive mode
  $0 --auto           # Automatic mode (uses defaults)
  $0 --debug          # Debug mode (trace output to /tmp/bloominstall-debug.log)

EOF
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --auto|-a)
                AUTO_MODE=1
                ROOT_PASSWORD="bloom"
                USER_PASSWORD="bloom"
                shift
                ;;
            --debug|-d)
                DEBUG_MODE=1
                set -x
                exec 2>/tmp/bloominstall-debug.log
                log_info "Debug mode enabled. Trace output: /tmp/bloominstall-debug.log"
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done

    # Display banner
    display_banner

    echo ""
    log_info "Starting Bloom OS installation..."
    echo ""

    # Run installation steps
    check_root
    check_dependencies
    detect_boot_mode
    select_disk
    partition_disk
    format_filesystems
    mount_filesystems
    bootstrap_base_system
    generate_fstab
    configure_system
    install_blossom_kernel
    install_grub_bootloader
    install_bloom_pm
    install_cherry_blossom_banner

    # Optional: install ultra-lightweight i3wm desktop environment
    if [[ ${AUTO_MODE} -eq 1 ]]; then
        setup_i3wm_desktop
    else
        echo ""
        read -rp "Install ultra-lightweight i3wm graphical environment? [y/N]: " install_i3
        install_i3="${install_i3,,}"
        if [[ "${install_i3}" == "y" || "${install_i3}" == "yes" ]]; then
            setup_i3wm_desktop
        else
            log_info "Skipping i3wm desktop installation"
        fi
    fi

    finalize_installation
}

# Execute main function
main "$@"