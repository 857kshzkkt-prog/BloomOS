# BLOOM PACKAGE MANAGER SETUP
# ═══════════════════════════════════════════════════════════════════════════

install_bloom_pm() {
    log_step "Installing Bloom Package Manager"

    # Copy bloom binary
    if [[ -f "${BLOOM_ROOT}/packages/bin/bloom" ]]; then
        cp "${BLOOM_ROOT}/packages/bin/bloom" /mnt/usr/local/bin/bloom
        chmod +x /mnt/usr/local/bin/bloom
        log_success "Bloom binary installed to /usr/local/bin/bloom"
    else
        log_warn "Bloom package manager not found"
    fi

    # Create database directories
    mkdir -p /mnt/var/lib/bloom/local
    mkdir -p /mnt/var/lib/bloom/meta
    mkdir -p /mnt/var/cache/bloom

    # Initialize meta-packages
    if [[ -f /mnt/usr/local/bin/bloom ]]; then
        arch-chroot /mnt bloom meta-init 2>/dev/null || {
            log_warn "Meta-package initialization may have failed"
        }
        log_success "Meta-packages initialized"
    fi

    # Configure bloom as package manager
    if [[ -f /mnt/usr/local/bin/bloom ]]; then
        # Add bloom to pacman.conf as an alternative (optional)
        # This is informational - bloom operates independently
        log_info "Bloom package manager ready for use"
    fi
}

