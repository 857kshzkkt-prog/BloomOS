    # ─────────────────────────────────────────────────────────────────────────

    log_info "Creating default i3 configuration..."

    mkdir -p /mnt/etc/skel/.config/i3

    cat > /mnt/etc/skel/.config/i3/config <<'EOFI3CONF'
