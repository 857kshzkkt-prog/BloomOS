# I3WM GRAPHICAL PIPELINE SETUP (Ultra-Lightweight Desktop)
# ═══════════════════════════════════════════════════════════════════════════

setup_i3wm_desktop() {
    log_step "Installing Ultra-Lightweight i3wm Desktop Environment"

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 1: Install graphical packages via pacman inside chroot
    # ─────────────────────────────────────────────────────────────────────────

    log_info "Installing Xorg, i3wm, and supporting utilities..."

    # Core package array for a minimal yet usable graphical environment
    local desktop_packages=(
        "xorg-server"
        "xorg-xinit"
        "xorg-drivers"
        "i3-wm"
        "i3status"
        "i3lock"
        "dmenu"
        "alacritty"
        "xorg-xrandr"
        "xorg-xsetroot"
        "xorg-xbacklight"
        "xdotool"
        "ttf-dejavu"
        "ttf-liberation"
    )

    if ! arch-chroot /mnt pacman -S --noconfirm --needed "${desktop_packages[@]}"; then
        log_warn "Desktop package installation encountered warnings — continuing"
    fi

    log_success "Desktop packages installed"

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 2: Create .xinitrc in /etc/skel so every new user gets it
    # ─────────────────────────────────────────────────────────────────────────

    log_info "Writing ~/.xinitrc to launch i3 on 'startx'..."

    cat > /mnt/etc/skel/.xinitrc <<'EOFXINITRC'
#!/usr/bin/env bash
# Minimal .xinitrc for Bloom OS — launches i3 window manager

# Set a wallpaper or background colour (optional)
xsetroot -solid "#1a0a0e"

# Load system resources
if [[ -f /etc/X11/xinit/xinitrc.d/50-systemd-user.sh ]]; then
    source /etc/X11/xinit/xinitrc.d/50-systemd-user.sh
fi

# Launch i3 window manager
exec i3
EOFXINITRC

    chmod 644 /mnt/etc/skel/.xinitrc

    # Copy to root's home
    cp /mnt/etc/skel/.xinitrc /mnt/root/.xinitrc 2>/dev/null || true

    # Copy to existing user if one was created
    if [[ -n "${USER_NAME}" ]] && [[ -d "/mnt/home/${USER_NAME}" ]]; then
        cp /mnt/etc/skel/.xinitrc "/mnt/home/${USER_NAME}/.xinitrc"
        arch-chroot /mnt chown "${USER_NAME}:${USER_NAME}" "/home/${USER_NAME}/.xinitrc" 2>/dev/null || true
    fi

    log_success ".xinitrc deployed to /etc/skel and user homes"

    # ─────────────────────────────────────────────────────────────────────────
