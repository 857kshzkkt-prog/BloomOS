#!/usr/bin/env bash
###############################################################################
# bloominstall — Automated Bloom OS Installer
#
# An interactive, production-ready installer for Bloom OS that automates:
#   1. Disk detection and selection
#   2. Partitioning (UEFI/GPT or BIOS/MBR)
#   3. Filesystem formatting
#   4. Base system bootstrapping (pacstrap)
#   5. Kernel installation (Blossom kernel)
#   6. GRUB bootloader deployment
#   7. Bloom package manager setup
#   8. Cherry Blossom banner injection
#   9. User creation and configuration
#
# Architecture: Modeled after the official archinstall script
# Usage: sudo ./bloominstall [--auto] [--help]
#
###############################################################################

set -euo pipefail

# ═══════════════════════════════════════════════════════════════════════════
# COLOUR OUTPUT CONSTANTS
# ═══════════════════════════════════════════════════════════════════════════

readonly C_RESET='\033[0m'
readonly C_BOLD='\033[1m'
readonly C_DIM='\033[2m'
readonly C_RED='\033[0;31m'
readonly C_GREEN='\033[0;32m'
readonly C_YELLOW='\033[1;33m'
readonly C_BLUE='\033[0;34m'
readonly C_MAGENTA='\033[0;35m'
readonly C_CYAN='\033[0;36m'
readonly C_PINK='\033[1;35m'

# ═══════════════════════════════════════════════════════════════════════════
# LOGGING FUNCTIONS
# ═══════════════════════════════════════════════════════════════════════════

log_info()    { echo -e "${C_GREEN}[INSTALLER]${C_RESET} $*"; }
log_warn()    { echo -e "${C_YELLOW}[INSTALLER]${C_RESET} WARNING: $*"; }
log_error()   { echo -e "${C_RED}[INSTALLER]${C_RESET} ERROR: $*"; exit 1; }
log_step()    { echo -e "\n${C_MAGENTA}━━━ $* ═══${C_RESET}"; }
log_success() { echo -e "${C_GREEN}✓ $*${C_RESET}"; }
log_header()  { echo -e "\n${C_CYAN}═══════════════════════════════════════════════════════════════${C_RESET}"; }

# ═══════════════════════════════════════════════════════════════════════════
# GLOBAL VARIABLES
# ═══════════════════════════════════════════════════════════════════════════

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BLOOM_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Installation targets
TARGET_DISK=""
ROOT_PARTITION=""
BOOT_PARTITION=""
ESP_PARTITION=""

# Boot mode (detected automatically)
BOOT_MODE=""  # "uefi" or "bios"

# Installation options (can be set via --auto)
AUTO_MODE=0
DEBUG_MODE=0
ROOT_PASSWORD=""
USER_NAME="bloom"
USER_PASSWORD=""
HOSTNAME="bloom-os"
TIMEZONE="UTC"
LOCALE="en_US.UTF-8"
KEYMAP="us"

# Package selections
INSTALL_WIFI=1
INSTALL_BLOOM_PM=1

# ═══════════════════════════════════════════════════════════════════════════
# PREFLIGHT CHECKS
# ═══════════════════════════════════════════════════════════════════════════

check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "This installer must be run as root (sudo)."
    fi
}

check_dependencies() {
    log_step "Checking installation dependencies"

    local missing_packages=()

    # Essential packages for installation
    local required_packages=(
        "pacstrap"
        "arch-chroot"
        "mkfs.ext4"
        "mkfs.vfat"
        "sgdisk"
        "partprobe"
        "curl"
        "wget"
    )

    for pkg in "${required_packages[@]}"; do
        if ! command -v "${pkg}" &>/dev/null; then
            # Some commands might be in different packages
            case "${pkg}" in
                "pacstrap"|"arch-chroot")
                    if ! pacman -Q base &>/dev/null; then
                        missing_packages+=("base")
                    fi
                    ;;
                *)
                    missing_packages+=("${pkg}")
                    ;;
            esac
        fi
    done

    if [[ ${#missing_packages[@]} -gt 0 ]]; then
        log_info "Installing missing dependencies..."
        pacman -Sy --noconfirm --needed "${missing_packages[@]}" 2>/dev/null || true
    fi

    # Check for network connectivity
    if ! ping -c 1 -W 3 8.8.8.8 &>/dev/null; then
        log_warn "No internet connection detected. Some features may not work."
    else
        log_success "Internet connection verified"
    fi

    # Ensure system clock is synchronized
    timedatectl set-ntp true 2>/dev/null || true
}

detect_boot_mode() {
    if [[ -d /sys/firmware/efi/efivars ]]; then
        BOOT_MODE="uefi"
        log_info "Boot mode detected: UEFI (64-bit)"
    else
        BOOT_MODE="bios"
        log_info "Boot mode detected: Legacy BIOS"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# DISK SELECTION AND PARTITIONING
# ═══════════════════════════════════════════════════════════════════════════

select_disk() {
    log_step "Selecting Target Disk"

    echo ""
    echo "Available block devices:"
    echo ""

    # List all disks with detailed information
    local disk_list=()
    local disk_index=1

    while read -r line; do
        local disk_path device_name size device_type
        device_name=$(echo "${line}" | awk '{print $1}')
        size=$(echo "${line}" | awk '{print $2}')
        device_type=$(echo "${line}" | awk '{print $3}')

        if [[ "${device_type}" == "disk" ]]; then
            disk_list+=("${device_name}")
            echo "  ${disk_index}. ${device_name} (${size})"
            ((disk_index++))
        fi
    done < <(lsblk -dnpo NAME,SIZE,TYPE 2>/dev/null | grep -E "disk")

    if [[ ${#disk_list[@]} -eq 0 ]]; then
        log_error "No disks found. Cannot continue."
    fi

    echo ""

    # Auto-select if only one disk or in auto mode
    if [[ ${AUTO_MODE} -eq 1 ]] || [[ ${#disk_list[@]} -eq 1 ]]; then
        TARGET_DISK="${disk_list[0]}"
        log_info "Auto-selected disk: ${TARGET_DISK}"
    else
        read -rp "Enter disk number to install Bloom OS: " disk_num

        if [[ -z "${disk_num}" ]]; then
            log_error "No disk selected."
        fi

        if [[ ! "${disk_num}" =~ ^[0-9]+$ ]] || [[ ${disk_num} -lt 1 ]] || [[ ${disk_num} -gt ${#disk_list[@]} ]]; then
            log_error "Invalid disk number selected."
        fi

        TARGET_DISK="${disk_list[$((disk_num - 1))]}"
    fi

    # Show warning about data destruction
    echo ""
    log_warn "ALL DATA ON ${TARGET_DISK} WILL BE DESTROYED!"
    echo ""

    if [[ ${AUTO_MODE} -eq 0 ]]; then
        read -rp "Type 'yes' to continue: " confirm
        # Normalise to lowercase and accept both 'y' and 'yes'
        confirm="${confirm,,}"
        if [[ "${confirm}" != "yes" && "${confirm}" != "y" ]]; then
            log_error "Installation cancelled by user."
        fi
    else
        log_info "Auto-mode: Proceeding with installation..."
    fi
}

partition_disk() {
    log_step "Partitioning ${TARGET_DISK}"

    # Wipe existing signatures
    log_info "Wiping existing partition signatures..."
    wipefs -a "${TARGET_DISK}" &>/dev/null || true
    partprobe "${TARGET_DISK}" 2>/dev/null || true
    sleep 1

    if [[ "${BOOT_MODE}" == "uefi" ]]; then
        # UEFI: GPT with ESP + Root
        log_info "Creating GPT partition table (UEFI mode)..."

        # Partition 1: EFI System Partition (512 MB)
        sgdisk --zap-all "${TARGET_DISK}"
        sgdisk -n 1:0:+512M -t 1:ef00 -c 1:"EFI System Partition" "${TARGET_DISK}"

        # Partition 2: Root partition (remaining space)
        sgdisk -n 2:0:0 -t 2:8300 -c 2:"Linux Root" "${TARGET_DISK}"

        ESP_PARTITION="${TARGET_DISK}1"
        ROOT_PARTITION="${TARGET_DISK}2"
        BOOT_PARTITION=""

        log_success "Created ESP: ${ESP_PARTITION} (512 MB)"
        log_success "Created Root: ${ROOT_PARTITION} (remaining)"

    else
        # BIOS: MBR with BIOS Boot + Boot + Root
        log_info "Creating MBR partition table (BIOS mode)..."

        # Partition 1: BIOS Boot (1 MB)
        sgdisk --zap-all "${TARGET_DISK}"
        sgdisk -n 1:0:+1M -t 1:ef02 -c 1:"BIOS Boot" "${TARGET_DISK}"

        # Partition 2: Boot partition (512 MB)
        sgdisk -n 2:0:+512M -t 2:8300 -c 2:"Linux Boot" "${TARGET_DISK}"

        # Partition 3: Root partition (remaining space)
        sgdisk -n 3:0:0 -t 3:8300 -c 3:"Linux Root" "${TARGET_DISK}"

        ESP_PARTITION=""
        BOOT_PARTITION="${TARGET_DISK}2"
        ROOT_PARTITION="${TARGET_DISK}3"

        log_success "Created BIOS Boot: ${TARGET_DISK}1 (1 MB)"
        log_success "Created Boot: ${BOOT_PARTITION} (512 MB)"
        log_success "Created Root: ${ROOT_PARTITION} (remaining)"
    fi

    # Ensure kernel recognizes new partitions
    partprobe "${TARGET_DISK}" 2>/dev/null || true
    sleep 2

    # Verify partitions exist
    if [[ ! -b "${ROOT_PARTITION}" ]]; then
        log_error "Root partition not found after partitioning."
    fi
}

format_filesystems() {
    log_step "Formatting Filesystems"

    # ═══════════════════════════════════════════════════════════════════════
    # AGGRESSIVE UNMOUNT: Release all locks from prior runs
    # ═══════════════════════════════════════════════════════════════════════

    log_info "Releasing any active filesystem mounts..."

    umount -R /mnt 2>/dev/null || true

    if [[ -n "${ROOT_PARTITION}" ]]; then
        umount "${ROOT_PARTITION}" 2>/dev/null || true
    fi
    if [[ -n "${ESP_PARTITION}" ]]; then
        umount "${ESP_PARTITION}" 2>/dev/null || true
    fi
    if [[ -n "${BOOT_PARTITION}" ]]; then
        umount "${BOOT_PARTITION}" 2>/dev/null || true
    fi

    # Wait for unmounts to settle
    sleep 2

    log_success "All mounts released"

    if [[ "${BOOT_MODE}" == "uefi" ]]; then
        # Format ESP as FAT32
        log_info "Formatting ESP as FAT32..."
        mkfs.vfat -F32 -n "BLOOM-ESP" "${ESP_PARTITION}"
        log_success "Formatted: ${ESP_PARTITION} → FAT32"
    else
        # Format Boot as ext4
        log_info "Formatting Boot partition as ext4..."
        mkfs.ext4 -L "BLOOM-BOOT" "${BOOT_PARTITION}"
        log_success "Formatted: ${BOOT_PARTITION} → ext4"
    fi

    # Format Root as ext4
    log_info "Formatting Root partition as ext4..."
    mkfs.ext4 -L "BLOOM-ROOT" "${ROOT_PARTITION}"
    log_success "Formatted: ${ROOT_PARTITION} → ext4"
}

mount_filesystems() {
    log_step "Mounting Filesystems"

    # Mount root
    log_info "Mounting Root partition..."
    mount "${ROOT_PARTITION}" /mnt
    log_success "Mounted: ${ROOT_PARTITION} → /mnt"

    # Create and mount boot
    if [[ "${BOOT_MODE}" == "uefi" ]]; then
        log_info "Mounting ESP..."
        mkdir -p /mnt/boot
        mount "${ESP_PARTITION}" /mnt/boot
        log_success "Mounted: ${ESP_PARTITION} → /mnt/boot"
    else
        log_info "Mounting Boot partition..."
        mkdir -p /mnt/boot
        mount "${BOOT_PARTITION}" /mnt/boot
        log_success "Mounted: ${BOOT_PARTITION} → /mnt/boot"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# BASE SYSTEM INSTALLATION
# ═══════════════════════════════════════════════════════════════════════════

bootstrap_base_system() {
    log_step "Installing Base System"

    # ═══════════════════════════════════════════════════════════════════════
    # STEP 1: Sync package databases on the host system
    # ═══════════════════════════════════════════════════════════════════════

    log_info "Synchronizing package databases with Arch Linux mirrors..."

    # Run pacman sync to update local package databases
    if ! pacman -Sy --noconfirm; then
        log_error "Failed to synchronize package databases. Check your internet connection."
    fi

    log_success "Package databases synchronized"

    # ═══════════════════════════════════════════════════════════════════════
    # STEP 2: Verify essential tools are available
    # ═══════════════════════════════════════════════════════════════════════

    log_info "Verifying essential installation tools..."

    # Check for pacstrap
    if ! command -v pacstrap &>/dev/null; then
        log_info "Installing arch-install-scripts for pacstrap..."
        pacman -Sy --noconfirm arch-install-scripts
    fi

    # Verify pacstrap is now available
    if ! command -v pacstrap &>/dev/null; then
        log_error "pacstrap is not available. Cannot continue with installation."
    fi

    # ═══════════════════════════════════════════════════════════════════════
    # STEP 3: Run pacstrap to install base Arch Linux system
    # ═══════════════════════════════════════════════════════════════════════

    log_info "Running pacstrap to install base Arch Linux..."

    # Define the core package list for a minimal bootable Arch system
    # Note: 'bsdtar' is provided by the 'libarchive' package
    local packages=(
        "base"
        "base-devel"
        "linux"
        "linux-firmware"
        "mkinitcpio"
        "libarchive"       # Provides bsdtar for package extraction
        "zstd"             # Compression tool for initramfs
        "sudo"
        "nano"
        "vim"
        "openssh"
        "dhcpcd"
        "iwd"
        "wpa_supplicant"
        "networkmanager"
        "iproute2"
        "inetutils"
        "less"
        "man-db"
        "man-pages"
        "texinfo"
        "dosfstools"
        "mtools"
        "gptfdisk"
        "curl"
        "wget"
        "git"
        "grub"
    )

    # Execute pacstrap with the package list
    if ! pacstrap /mnt "${packages[@]}"; then
        log_error "Failed to install base system packages via pacstrap."
    fi

    # Verify the installation was successful by checking if critical files exist
    if [[ ! -f /mnt/etc/passwd ]]; then
        log_error "Base system installation appears incomplete. /mnt/etc/passwd not found."
    fi

    if [[ ! -d /mnt/var/lib/pacman ]]; then
        log_error "Base system installation appears incomplete. /mnt/var/lib/pacman not found."
    fi

    log_success "Base system installed successfully to /mnt"
}

generate_fstab() {
    log_step "Generating /etc/fstab"

    genfstab -U /mnt >> /mnt/etc/fstab

    # Add tmpfs for /tmp for better security
    echo "tmpfs /tmp tmpfs defaults,noatime,mode=1777 0 0" >> /mnt/etc/fstab

    log_success "fstab generated at /mnt/etc/fstab"
}

# ═══════════════════════════════════════════════════════════════════════════
# SYSTEM CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

configure_system() {
    log_step "Configuring System"

    # Set hostname
    echo "${HOSTNAME}" > /mnt/etc/hostname
    log_info "Set hostname: ${HOSTNAME}"

    # Configure /etc/hosts
    cat > /mnt/etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
EOF
    log_info "Configured /etc/hosts"

    # Set timezone
    if [[ -f "/usr/share/zoneinfo/${TIMEZONE}" ]]; then
        ln -sf "/usr/share/zoneinfo/${TIMEZONE}" /mnt/etc/localtime
        log_info "Set timezone: ${TIMEZONE}"
    else
        ln -sf /usr/share/zoneinfo/UTC /mnt/etc/localtime
        log_info "Set timezone: UTC (default)"
    fi

    # Configure locale
    echo "${LOCALE} UTF-8" > /mnt/etc/locale.gen
    arch-chroot /mnt locale-gen 2>/dev/null || true
    echo "LANG=${LOCALE}" > /mnt/etc/locale.conf
    log_info "Configured locale: ${LOCALE}"

    # Set root password
    if [[ -n "${ROOT_PASSWORD}" ]]; then
        echo "root:${ROOT_PASSWORD}" | arch-chroot /mnt chpasswd
        log_info "Set root password"
    else
        log_warn "Root password not set (use 'sudo su' after reboot)"
    fi

    # Create user
    if [[ -n "${USER_NAME}" ]]; then
        arch-chroot /mnt useradd -m -G wheel -s /bin/bash "${USER_NAME}" 2>/dev/null || true

        if [[ -n "${USER_PASSWORD}" ]]; then
            echo "${USER_NAME}:${USER_PASSWORD}" | arch-chroot /mnt chpasswd
            log_info "Created user: ${USER_NAME}"
        else
            log_warn "User password not set"
        fi

        # Enable sudo for wheel group
        echo "%wheel ALL=(ALL:ALL) ALL" > /mnt/etc/sudoers.d/wheel
        chmod 440 /mnt/etc/sudoers.d/wheel
    fi

    # Enable essential services
    log_info "Enabling system services..."
    # Use manual symlinks instead of systemctl to avoid systemd-journald coredumps in chroot
    local services=("dhcpcd" "iwd" "NetworkManager" "sshd")
    for svc in "${services[@]}"; do
        if [[ -f "/mnt/usr/lib/systemd/system/${svc}.service" ]]; then
            mkdir -p "/mnt/etc/systemd/system/multi-user.target.wants"
            ln -sf "/usr/lib/systemd/system/${svc}.service" \
                "/mnt/etc/systemd/system/multi-user.target.wants/${svc}.service" 2>/dev/null || true
            log_info "Enabled: ${svc}"
        fi
    done

    log_success "System services enabled"
}

# ═══════════════════════════════════════════════════════════════════════════
# BLOSSOM KERNEL INSTALLATION
# ══════════════════════════════════════════════════════════════════════════

verify_chroot_environment() {
    log_info "Verifying chroot environment for kernel installation..."

    local warnings=0

    # Check if mkinitcpio is installed in chroot
    if [[ ! -f /mnt/usr/bin/mkinitcpio ]]; then
        log_warn "mkinitcpio not found in chroot - will install during kernel setup"
        ((warnings++))
    else
        log_success "mkinitcpio found in chroot"
    fi

    # Check if kernel modules directory exists
    if [[ -d /mnt/usr/lib/modules ]]; then
        local module_count
        module_count=$(find /mnt/usr/lib/modules -name "*.ko*" 2>/dev/null | wc -l)
        log_info "Found ${module_count} kernel modules in chroot"
        if [[ ${module_count} -eq 0 ]]; then
            log_warn "No kernel modules found - kernel may not be installed"
            ((warnings++))
        fi
    else
        log_warn "No /usr/lib/modules directory in chroot"
        ((warnings++))
    fi

    # Check mkinitcpio.conf syntax
    if [[ -f /mnt/etc/mkinitcpio.conf ]]; then
        if ! bash -n /mnt/etc/mkinitcpio.conf 2>/dev/null; then
            log_warn "mkinitcpio.conf may have syntax issues"
            ((warnings++))
        else
            log_success "mkinitcpio.conf syntax OK"
        fi
    else
        log_warn "mkinitcpio.conf not found - will create during setup"
        ((warnings++))
    fi

    # Check preset files
    if [[ -d /mnt/etc/mkinitcpio.d ]]; then
        local preset_count
        preset_count=$(ls /mnt/etc/mkinitcpio.d/*.preset 2>/dev/null | wc -l)
        log_info "Found ${preset_count} mkinitcpio preset files"
    fi

    if [[ ${warnings} -gt 0 ]]; then
        log_warn "Chroot environment has ${warnings} warnings - proceeding with caution"
    else
        log_success "Chroot environment verification complete"
    fi
}

install_blossom_kernel() {
    log_step "Installing Blossom Kernel"

    # Verify chroot environment before proceeding
    verify_chroot_environment

    # Check if kernel build script exists
    if [[ -f "${BLOOM_ROOT}/kernel/build-blossom-kernel.sh" ]]; then
        log_info "Building Blossom kernel (this may take 10-30 minutes)..."

        # Copy kernel build script to /mnt
        mkdir -p /mnt/opt/bloom-os
        cp -r "${BLOOM_ROOT}/kernel" /mnt/opt/bloom-os/

        # Run kernel build in chroot
        if ! arch-chroot /mnt bash /opt/bloom-os/kernel/build-blossom-kernel.sh; then
            log_warn "Blossom kernel build failed, falling back to standard Arch kernel"

            # Check if linux is already installed from pacstrap
            if arch-chroot /mnt pacman -Q linux &>/dev/null; then
                log_info "Standard kernel already installed, regenerating initramfs..."
            else
                log_info "Installing standard Arch kernel..."
                arch-chroot /mnt pacman -S --noconfirm --needed linux || {
                    log_error "Failed to install standard Arch kernel"
                }
            fi
        fi
    else
        log_warn "Kernel build script not found, installing standard Arch kernel..."
        arch-chroot /mnt pacman -S --noconfirm --needed linux || {
            log_error "Failed to install standard Arch kernel"
        }
    fi

    # Verify kernel installation
    if [[ -f /mnt/boot/vmlinuz-blossom ]]; then
        log_success "Blossom kernel installed: /boot/vmlinuz-blossom"
    elif [[ -f /mnt/boot/vmlinuz-linux ]]; then
        cp /mnt/boot/vmlinuz-linux /mnt/boot/vmlinuz-blossom
        log_success "Copied standard kernel as vmlinuz-blossom"
    else
        log_error "No kernel image found"
    fi

    # ═══════════════════════════════════════════════════════════════════════════
    # GENERATE INITRAMFS WITH PROPER CONFIGURATION
    # ═══════════════════════════════════════════════════════════════════════════

    log_info "Generating initramfs..."

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 1: Deploy essential configuration files for initramfs generation
    # ─────────────────────────────────────────────────────────────────────────

    log_info "Deploying mkinitcpio configuration..."

    # Ensure mkinitcpio.d directory exists
    mkdir -p /mnt/etc/mkinitcpio.d

    # Deploy lean mkinitcpio.conf if available, otherwise create minimal version
    if [[ -f "${BLOOM_ROOT}/system/config/mkinitcpio.conf" ]]; then
        cp "${BLOOM_ROOT}/system/config/mkinitcpio.conf" /mnt/etc/mkinitcpio.conf
    else
        # Create minimal mkinitcpio.conf
        cat > /mnt/etc/mkinitcpio.conf <<'EOFMKINIT'
# Minimal mkinitcpio.conf for Bloom OS
MODULES=(
    ahci
    sd_mod
    nvme
    ext4
    hid_generic
    usbhid
    psmouse
    atkbd
    e1000e
    r8169
    igb
    iwlwifi
    ath9k
    drm
    i915
    fbcon
)

HOOKS=(
    base
    systemd
    autodetect
    microcode
    keyboard
    keymap
    modconf
    block
    filesystems
    fsck
)

COMPRESSION="zstd"
EOFMKINIT
    fi

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 2: Create console configuration to prevent sd-vconsole hook failure
    # ─────────────────────────────────────────────────────────────────────────

    log_info "Configuring console settings..."

    # Create /mnt/etc/vconsole.conf with default settings
    cat > /mnt/etc/vconsole.conf <<'EOFVCONSOLE'
# Virtual console configuration for Bloom OS
KEYMAP=us
FONT=ter-v16n
EOFVCONSOLE

    # Also set locale for early console
    echo "LANG=en_US.UTF-8" > /mnt/etc/locale.conf 2>/dev/null || true

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 3: Create mkinitcpio preset for blossom kernel
    # ─────────────────────────────────────────────────────────────────────────

    log_info "Creating mkinitcpio preset..."

    cat > /mnt/etc/mkinitcpio.d/blossom.preset <<'EOFPRESET'
# mkinitcpio preset for Blossom kernel
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="/boot/vmlinuz-blossom"
ALL_microcode=()
blossom_image="/boot/initramfs-blossom.img"
blossom_fallback_image="/boot/initramfs-blossom-fallback.img"
blossom_fallback_options="-S autodetect"
EOFPRESET

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 4: Generate initramfs using explicit targeted command
    # ─────────────────────────────────────────────────────────────────────────

    log_info "Building initramfs with explicit configuration..."

    # Run mkinitcpio with explicit kernel and output paths
    local mkinitcpio_log="/tmp/mkinitcpio-debug.log"
    if arch-chroot /mnt bash -c "mkinitcpio -k vmlinuz-blossom -c /etc/mkinitcpio.conf -g /boot/initramfs-blossom.img 2>&1 | tee ${mkinitcpio_log}"; then
        log_success "Initramfs generated successfully"
    else
        # If that fails, try alternative method
        log_warn "Primary method failed, trying alternative generation..."
        log_warn "Check ${mkinitcpio_log} for detailed error output"

        if arch-chroot /mnt mkinitcpio -p blossom 2>&1 | tee -a "${mkinitcpio_log}"; then
            # Copy the generated initramfs to our named version
            if [[ -f /mnt/boot/initramfs-linux.img ]]; then
                cp /mnt/boot/initramfs-linux.img /mnt/boot/initramfs-blossom.img
                log_success "Initramfs generated via preset"
            else
                log_error "Initramfs generation failed - no output file created. See ${mkinitcpio_log}"
            fi
        else
            log_error "All initramfs generation methods failed. See ${mkinitcpio_log}"
        fi
    fi

    # ─────────────────────────────────────────────────────────────────────────
    # STEP 5: Verify initramfs was created successfully
    # ─────────────────────────────────────────────────────────────────────────

    if [[ -f /mnt/boot/initramfs-blossom.img ]]; then
        local initramfs_size
        initramfs_size=$(du -h /mnt/boot/initramfs-blossom.img | awk '{print $1}')
        log_success "Initramfs created: /boot/initramfs-blossom.img (${initramfs_size})"
    else
        log_error "Initramfs generation FAILED - /mnt/boot/initramfs-blossom.img not found"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════
# GRUB BOOTLOADER INSTALLATION
# ═══════════════════════════════════════════════════════════════════════════

install_grub_bootloader() {
    log_step "Installing GRUB Bootloader"

    # Get partition UUIDs
    local root_uuid
    root_uuid=$(blkid -s UUID -o value "${ROOT_PARTITION}")

    # Determine which partition holds the kernels (boot partition or ESP)
    local kernel_part_uuid=""
    if [[ -n "${BOOT_PARTITION}" ]]; then
        kernel_part_uuid=$(blkid -s UUID -o value "${BOOT_PARTITION}")
    elif [[ -n "${ESP_PARTITION}" ]]; then
        kernel_part_uuid=$(blkid -s UUID -o value "${ESP_PARTITION}")
    fi

    # Install GRUB based on boot mode
    if [[ "${BOOT_MODE}" == "uefi" ]]; then
        log_info "Installing GRUB for UEFI (x86_64-efi)..."
        arch-chroot /mnt grub-install --target=x86_64-efi --boot-directory=/boot --efi-directory=/boot --recheck || {
            log_error "GRUB UEFI installation failed"
        }
    else
        log_info "Installing GRUB for BIOS (i386-pc)..."
        arch-chroot /mnt grub-install --target=i386-pc --boot-directory=/boot --recheck "${TARGET_DISK}" || {
            log_error "GRUB BIOS installation failed"
        }
    fi

    # Create custom entry for Blossom kernel
    log_info "Creating GRUB custom entry for Blossom kernel..."

    cat > /mnt/etc/grub.d/40_custom << GRUBEOF
#!/bin/sh
exec tail -n +3 \$0

menuentry 'Bloom OS (Blossom kernel)' --class linux --class bloom {
    search --no-floppy --fs-uuid --set=root ${kernel_part_uuid}
    linux /vmlinuz-blossom root=UUID=${root_uuid} rw quiet loglevel=3
    initrd /initramfs-blossom.img
}

menuentry 'Bloom OS (stock kernel)' --class linux --class bloom {
    search --no-floppy --fs-uuid --set=root ${kernel_part_uuid}
    linux /vmlinuz-linux root=UUID=${root_uuid} rw quiet loglevel=3
    initrd /initramfs-linux.img
}
GRUBEOF

    chmod +x /mnt/etc/grub.d/40_custom

    # Generate GRUB config
    log_info "Generating GRUB configuration..."
    arch-chroot /mnt grub-mkconfig -o /boot/grub/grub.cfg || {
        log_error "GRUB configuration generation failed"
    }

    log_success "GRUB bootloader installed successfully"
}

