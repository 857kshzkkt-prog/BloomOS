# ═══════════════════════════════════════════════════════════════════════════
# MAIN ENTRY POINT
# ═══════════════════════════════════════════════════════════════════════════

usage() {
    cat <<EOF
Usage: $0 [OPTIONS]

Options:
  --auto              Run in automatic mode with default options
  --help, -h          Show this help message

Examples:
  $0                  # Interactive mode
  $0 --auto           # Automatic mode (uses defaults)

EOF
}

main() {
    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --auto|-a)
                AUTO_MODE=1
                ROOT_PASSWORD="bloom"
                USER_PASSWORD="bloom"
                shift
                ;;
            --help|-h)
                usage
                exit 0
                ;;
            *)
                log_error "Unknown option: $1"
                usage
                exit 1
                ;;
        esac
    done

    # Display banner
    display_banner

    echo ""
    log_info "Starting Bloom OS installation..."
    echo ""

    # Run installation steps
    check_root
    check_dependencies
    detect_boot_mode
    select_disk
    partition_disk
    format_filesystems
    mount_filesystems
    bootstrap_base_system
    generate_fstab
    configure_system
    install_blossom_kernel
    install_limine_bootloader
    install_bloom_pm
    install_cherry_blossom_banner
    finalize_installation
}

# Execute main function
main "$@"